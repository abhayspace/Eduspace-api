# ---------------------------------------------------------------------------
# EduSpace backend environment configuration.
# Copy to `.env` and fill in real values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Supabase (PostgreSQL storage only; NOT Supabase Auth) ---
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Service role key (server-side only, bypasses RLS). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth: FastAPI-issued JWT ---
# Use a long, random value in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=
# Optional overrides:
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=525600

# --- Email (Resend) for transactional mail (OTP, welcome, support, etc.) ---
RESEND_API_KEY=
# Canonical From for all emails. Defaults to EduSpace <eduspace@nextforms.in>
RESEND_FROM_EMAIL=EduSpace <eduspace@nextforms.in>

# --- Legacy SMTP (optional; Resend is preferred) ---
EMAIL_USER=
EMAIL_PASSWORD=
# Optional SMTP overrides (defaults shown):
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# Optional explicit From address (defaults to EMAIL_USER):
EMAIL_FROM=

# --- Payment gateway credential encryption ---
# Optional Fernet key (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# If empty, a key is derived from JWT_SECRET.
PAYMENT_CREDENTIALS_KEY=

# --- Eddy AI Buddy (Groq) ---
# Create a key at https://console.groq.com/keys — never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- App ---
# Optional direct Postgres URI for running SQL migrations (Supabase → Database → URI).
DATABASE_URL=
# Comma-separated list of allowed CORS origins, or * for all.
CORS_ORIGINS=*
LOG_LEVEL=INFO
